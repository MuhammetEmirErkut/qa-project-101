// =============================================================================
// Jenkins Pipeline: UI Test Automation (Gauge & TestNG on Selenium Grid)
// Location: ci/pipelines/Jenkinsfile.ui
// =============================================================================

pipeline {
    agent any

    parameters {
        choice(name: 'TEST_RUNNER', choices: ['GAUGE', 'TESTNG'], description: 'UI Test Koşturucusu (Gauge BDD veya TestNG Suite)')
        string(name: 'GAUGE_SPECS_DIR', defaultValue: 'specs', description: 'Gauge: Specification Dizini (örn: specs, specs/login, specs/search, specs/cart, specs/pdp, specs/filter)')
        choice(name: 'BROWSER', choices: ['chrome', 'firefox'], description: 'Hedef Web Tarayıcısı')
        choice(name: 'HEADLESS', choices: ['true', 'false'], description: 'Headless Modda Çalıştır')
        string(name: 'THREAD_COUNT', defaultValue: '2', description: 'Paralel Thread Sayısı')
        string(name: 'SUITE_XML', defaultValue: 'testng.xml', description: 'TestNG Suite XML Dosyası (TestNG seçildiğinde)')
    }

    environment {
        SELENIUM_REMOTE_URL = 'http://selenium-hub:4444'
    }

    tools {
        maven 'Maven_3.9.6'
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {
        stage('Checkout Source') {
            steps {
                echo 'Checking out latest test automation code...'
                checkout scm
            }
        }

        stage('Environment Check') {
            steps {
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Execute UI Tests') {
            steps {
                script {
                    if (params.TEST_RUNNER == 'GAUGE') {
                        echo "📐 Running Gauge UI Specifications with specsDir=${params.GAUGE_SPECS_DIR}"
                        sh """
                            mkdir -p \$HOME/.local/bin
                            export PATH=\$HOME/.local/bin:\$PATH
                            if ! command -v gauge > /dev/null 2>&1; then
                                echo "📥 Gauge not found in Jenkins, downloading and installing Gauge CLI..."
                                curl -SsL https://downloads.gauge.org/stable | sh -s -- --location=\$HOME/.local/bin
                                gauge install java || true
                                gauge install html-report || true
                            fi
                            chmod +x ./gradlew
                            ./gradlew gauge -PspecsDir="${params.GAUGE_SPECS_DIR}"
                        """
                    } else {
                        echo "🌐 Running TestNG UI Tests with Browser=${params.BROWSER}, Headless=${params.HEADLESS}, Threads=${params.THREAD_COUNT}"
                        sh """
                            mvn clean test \
                                -Dbrowser=${params.BROWSER} \
                                -Dheadless=${params.HEADLESS} \
                                -Dremote=true \
                                -DgridUrl=${SELENIUM_REMOTE_URL} \
                                -Dsurefire.suiteXmlFiles=${params.SUITE_XML}
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Archiving Results and Publishing Reports...'
            allure([
                includeProperties: false,
                jdk: '',
                properties: [],
                reportBuildPolicy: 'ALWAYS',
                results: [[path: 'target/allure-results'], [path: 'build/allure-results']]
            ])
            junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml, build/test-results/**/*.xml'
            publishHTML([
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'reports/html-report',
                reportFiles: 'index.html',
                reportName: 'Gauge Test Report'
            ])
        }
        success {
            echo 'UI Automation Tests Passed Successfully! 🚀'
        }
        failure {
            echo 'UI Automation Tests Failed! ❌'
        }
    }
}
