// =============================================================================
// Jenkins Pipeline: JMeter Performance & Load Testing
// Location: ci/pipelines/Jenkinsfile.perf
// =============================================================================

pipeline {
    agent any

    parameters {
        choice(name: 'TEST_TYPE', choices: ['SMOKE', 'LOAD', 'STRESS', 'SPIKE', 'SOAK'], description: 'Koşturulacak Test Profili')
        string(name: 'HOST', defaultValue: 'mock-api', description: 'Hedef API Host (Docker Network içinde: "mock-api" veya "localhost")')
        string(name: 'PORT', defaultValue: '3001', description: 'Hedef API Port')
    }

    environment {
        JMETER_VERSION = '5.6.3'
        JMETER_DIR = '/var/jenkins_home/tools/apache-jmeter-5.6.3'
    }

    triggers {
        // Her gece saat 02:00'de otomatik Load Test koş (Pazartesi-Cuma)
        cron('H 2 * * 1-5')
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Checking out latest repository code...'
                checkout scm
            }
        }

        stage('Ensure JMeter Runtime') {
            steps {
                echo 'Verifying Apache JMeter binary inside Jenkins environment...'
                sh """
                    if [ ! -f "${JMETER_DIR}/bin/jmeter" ]; then
                        echo "Downloading Apache JMeter ${JMETER_VERSION} into persistent storage..."
                        mkdir -p /var/jenkins_home/tools
                        curl -fsSL https://archive.apache.org/dist/jmeter/binaries/apache-jmeter-${JMETER_VERSION}.tgz -o /tmp/jmeter.tgz
                        tar -xzf /tmp/jmeter.tgz -C /var/jenkins_home/tools/
                        rm -f /tmp/jmeter.tgz
                        chmod +x ${JMETER_DIR}/bin/jmeter
                        echo "Apache JMeter successfully installed at ${JMETER_DIR}"
                    else
                        echo "Apache JMeter is already cached at ${JMETER_DIR}"
                    fi
                    ${JMETER_DIR}/bin/jmeter -v
                """
            }
        }

        stage('Execute JMeter Performance Tests') {
            steps {
                script {
                    def profileFile = "performance-test/jmeter/profiles/${params.TEST_TYPE.toLowerCase()}.properties"
                    echo "=========================================================="
                    echo "🚀 Running JMeter ${params.TEST_TYPE} Test"
                    echo "📁 Using Profile: ${profileFile}"
                    echo "🎯 Target: http://${params.HOST}:${params.PORT}"
                    echo "=========================================================="

                    sh """
                        # Clean previous run results
                        rm -rf performance-test/jmeter/results.jtl performance-test/jmeter/html-report

                        # Run JMeter in Non-GUI mode with dynamic profile and target
                        ${JMETER_DIR}/bin/jmeter -n \
                            -t performance-test/jmeter/ecommerce_api_test_plan.jmx \
                            -q ${profileFile} \
                            -Jhost=${params.HOST} \
                            -Jport=${params.PORT} \
                            -l performance-test/jmeter/results.jtl \
                            -e -o performance-test/jmeter/html-report
                    """
                }
            }
        }

        stage('Publish Performance Dashboard') {
            steps {
                echo 'Publishing Interactive JMeter HTML Report to Jenkins UI...'
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'performance-test/jmeter/html-report',
                    reportFiles: 'index.html',
                    reportName: "JMeter ${params.TEST_TYPE} Performance Dashboard"
                ])
            }
        }
    }

    post {
        always {
            echo 'Archiving Raw JTL Execution Logs...'
            archiveArtifacts artifacts: 'performance-test/jmeter/results.jtl', allowEmptyArchive: true, fingerprint: true
        }
        success {
            echo "JMeter ${params.TEST_TYPE} Test Completed Successfully! 🚀"
        }
        failure {
            echo "JMeter ${params.TEST_TYPE} Test Failed or SLA Violated! ❌ Check HTML Dashboard for details."
        }
    }
}
