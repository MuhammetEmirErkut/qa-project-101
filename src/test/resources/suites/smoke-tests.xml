<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Hepsiburada Smoke Test Suite" verbose="1" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="com.hepsiburada.qa.listeners.TestListener"/>
    </listeners>

    <test name="Smoke Tests - Critical User Journeys">
        <classes>
            <class name="com.hepsiburada.qa.tests.search.SearchTests">
                <methods>
                    <include name="testSearchProducts"/>
                </methods>
            </class>
            <class name="com.hepsiburada.qa.tests.cart.CartTests">
                <methods>
                    <include name="testAddProductToCart"/>
                </methods>
            </class>
            <class name="com.hepsiburada.qa.tests.login.LoginTests">
                <methods>
                    <include name="shouldShowErrorForInvalidEmailFormat"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
